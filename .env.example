# STS Media environment variables (names only — never commit real secrets)
# Copy this file to .env.local for local development.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=STS Media
# Set to "true" only for local/demo exploration. Must be "false" in production.
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# --- Supabase (required for real authentication and persistence) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Owner-only allowlist. Comma-separated. Production default is info@stsmedia.co.
# Never put a password in this file or in chat.
OWNER_EMAIL=info@stsmedia.co

# Optional, server-only: required to sign demo-session cookies when demo mode is on.
# Generate a long random string (at least 32 characters). Never commit a real value.
# openssl rand -base64 48
DEMO_SESSION_SECRET=

# --- Auth redirects (configure the same URLs in the Supabase dashboard) ---
# Site URL: http://localhost:3000 (local) or https://stsmedia.co (production)
# Redirect URLs:
#   http://localhost:3000/auth/callback
#   http://localhost:3000/reset-password
#   http://localhost:3000/invite/accept
#   http://localhost:3000/mfa/verify
#   https://stsmedia.co/auth/callback
#   https://stsmedia.co/reset-password
#   https://stsmedia.co/invite/accept
#   https://stsmedia.co/mfa/verify

# --- Optional Phase 2 integrations (leave empty until approved) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VERCEL_API_TOKEN=
SPACESHIP_DASHBOARD_URL=https://www.spaceship.com
NEXT_PUBLIC_ANALYTICS_ID=

# --- Email (Phase 2) ---
# Transactional mail is handled by Supabase Auth templates until a dedicated provider is connected.

# --- Security ---
# Optional CAPTCHA after suspicious login activity (Phase 2 / production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
